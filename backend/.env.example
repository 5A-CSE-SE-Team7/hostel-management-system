NODE_ENV=development
PORT=4000
# Bind locally behind the TLS terminator. Set an explicit host for direct TLS.
HOST=127.0.0.1
# Leave empty for direct TLS. Set loopback only for a local nginx proxy.
TRUST_PROXY=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=hms
DB_PASSWORD=hms_pass
DB_NAME=hms
SESSION_SECRET=change-me-to-a-long-random-string
# Frontend origin allowed by CORS (Vite dev server)
CORS_ORIGIN=http://localhost:5173
# Optional: restrict registration to an institutional email domain (HMS-F-001)
INSTITUTION_EMAIL_DOMAIN=
# Optional TLS termination inside Node (otherwise terminate TLS at nginx - see deploy/nginx.conf)
TLS_KEY_PATH=
TLS_CERT_PATH=
# Production always rejects plain HTTP, including health. Development can opt in.
REQUIRE_HTTPS=false
# Optional notification e-mail adapter (HMS-F-012). Leave SMTP_HOST empty for in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=hms@example.edu
